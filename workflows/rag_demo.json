      ],
      "id": "9d373446-64b2-49da-9829-ef803e13d4e4",
      "name": "Postgres Chat Memory"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "d072ece5-224c-43f0-8bab-451fb700262c",
                    "leftValue": "={{ ($('Telegram Trigger').item.json.message.text ?? '').trim() }}",
                    "rightValue": "",
                    "operator": {
                      "type": "string",
