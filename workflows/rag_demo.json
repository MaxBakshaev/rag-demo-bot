    },
    {
      "parameters": {
        "jsCode": "const out = [];\n$('Upload your file here').all().forEach((item, i) => {\n  for (const bin of Object.values(item.binary ?? {})) {\n    out.push({\n      json: { fileName: bin.fileName },\n      binary: { data: bin },\n      pairedItem: { item: i },\n    });\n  }\n});\nreturn out;"
      },
